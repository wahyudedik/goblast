{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "Watches PHP source files, config, routes, and other relevant project files. When changes are detected, prompts the agent to update the README or files in the /docs folder to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.php",
      "**/*.js",
      "**/*.ts",
      "composer.json",
      "package.json",
      "config/*.php",
      "routes/*.php",
      "bootstrap/app.php",
      "bootstrap/providers.php"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just modified. Review the change and determine if any documentation needs to be updated. Check the README.md for high-level documentation and the /docs folder (e.g. docs/DEPLOYMENT.md) for more specific guides. Update only the sections that are affected by the change — don't rewrite unrelated content."
  }
}