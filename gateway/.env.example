# Gateway Server Configuration
PORT=3000
HOST=0.0.0.0

# Laravel App Webhook URL
WEBHOOK_URL=http://goblast.test/api/webhooks/baileys
WEBHOOK_SECRET=your-webhook-secret-key-change-in-production

# Session Storage Path
SESSION_PATH=./sessions

# Logging
LOG_LEVEL=info

# Message Delay (ms) - to avoid WhatsApp rate limiting
MESSAGE_DELAY_MIN=3000
MESSAGE_DELAY_MAX=7000

# Session Restore Configuration
SESSION_RESTORE_DELAY_MS=5000
SESSION_RESTORE_MAX_CONCURRENT=3

# Exponential Backoff Configuration
BACKOFF_INITIAL_DELAY_MS=5000
BACKOFF_MAX_DELAY_MS=300000
BACKOFF_MULTIPLIER=2
BACKOFF_JITTER_FACTOR=0.3
BACKOFF_MAX_RETRIES=10

# Capacity
MAX_CONNECTIONS=100
